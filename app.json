{
  "expo": {
    "name": "BANHA",
    "slug": "banha-app",
    "version": "1.0.0",
    "scheme": "banha",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.banha.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": false
        },
        "NSLocalNetworkUsageDescription": "BANHA connects to your ESP32 Master node device over its local WiFi hotspot (BANHA-SETUP) to configure it and read live status."
      }
    },
    "android": {
      "package": "com.banha.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/bg_white.png"
      }
    },
    "web": {
      "favicon": "./assets/images/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ba045a9-d340-4c34-b10b-2089ccdae701"
      }
    }
  }
}
